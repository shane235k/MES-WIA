# Backend Configuration
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# =====================================================================
# MongoDB Configuration
# =====================================================================
# Option A: Local MongoDB
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=mes_db

# Option B: Cloud MongoDB Atlas (Uncomment and replace if using MongoDB Atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mes_db?retryWrites=true&w=majority

# =====================================================================
# Redis Configuration (Distributed Mutex & Health Engine)
# =====================================================================
# Option A: Local Redis Server
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Option B: Online / Cloud Redis Provider (Upstash, Redis Cloud, Aiven, Railway)
# Simply paste the full connection string given by your cloud provider:
#
# Examples:
# Upstash:     REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
# Redis Cloud: REDIS_URL=redis://default:your_rediscloud_pass@redis-12345.c10.us-east-1-2.ec2.cloud.redislabs.com:12345
# Aiven:       REDIS_URL=rediss://default:your_password@your-project.aivencloud.com:12345
#
# REDIS_URL=rediss://default:<password>@<host>:<port>

# =====================================================================
# AI Co-Pilot Configuration (Optional)
# =====================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
